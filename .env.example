# ===================================================
# Neo4j Configuration (REQUIRED for Railway/Production)
# ===================================================
# Get credentials from https://neo4j.com/cloud/aura
# Format: bolt://xxxxx.neo4j.io:7687
NEO4J_URI=bolt://your-instance.neo4j.io:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_from_aura

# ===================================================
# LLM API Keys (REQUIRED)
# ===================================================
# Google Gemini: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI: https://platform.openai.com/api-keys (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# ===================================================
# FastAPI Server Configuration
# ===================================================
# Note: Railway sets PORT automatically
# These should NOT be changed for Railway deployment
API_HOST=0.0.0.0
API_PORT=8000

# ===================================================
# Application Settings
# ===================================================
# Set to False for production
DEBUG=False

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=*

# ===================================================
# Feature Flags (Optional)
# ===================================================
# Enable document ingestion
ENABLE_INGESTION=True

# Enable RAG engine
ENABLE_RAG=True

# Max file upload size (MB)
MAX_UPLOAD_SIZE=50
